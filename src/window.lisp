;;;; game-window.lisp
;;;; Basic Window manager using glfw

(in-package #:cl-3d-fps)

(defvar *triangle-red* 1)
(defvar *triangle-green* 1)
(defvar *triangle-blue* 1)
(defvar *rotation-theta-x* 0)
(defvar *rotation-theta-y* 0)
(defvar *rotation-theta-z* 0)
(defvar *translation-x* 0)
(defvar *translation-y* 0)
(defvar *translation-z* 0)
(defvar *keys-down* (list 0 0 0 0 0 0 0)) ;; w a s d q e shift
(defvar *win-width* 600)
(defvar *win-height* 400)
(defvar *win-middle* (list 300.0d0 200.0d0))
(defvar *win-focused* t)
(defvar pi-over-180 (/ pi 180.0d0))
(defvar *cube-rotation* 0.0d0)
(defvar *cube-rotation-speed* 2.5)

(defun drop-from-key-list (item)
  (cond ((eq item :w)
         (setf (elt *keys-down* 0) 0))
        ((eq item :a)
         (setf (elt *keys-down* 1) 0))
        ((eq item :s)
         (setf (elt *keys-down* 2) 0))
        ((eq item :d)
         (setf (elt *keys-down* 3) 0))
        ((eq item :q)
         (setf (elt *keys-down* 4) 0))
        ((eq item :e)
         (setf (elt *keys-down* 5) 0))
        ((eq item :+)
         (setf (elt *keys-down* 7) 0))
        ((eq item :-)
         (setf (elt *keys-down* 8) 0))
        ((eq item :shift)
         (setf (elt *keys-down* 6) 0))
        ((eq item :+)
         (setf (elt *keys-down* 7) 0))
        ((eq item :-)
         (setf (elt *keys-down* 8) 0))))

(defun add-to-key-list (item)
  (cond ((eq item :w)
         (setf (elt *keys-down* 0) 1))
        ((eq item :a)
         (setf (elt *keys-down* 1) 1))
        ((eq item :s)
         (setf (elt *keys-down* 2) 1))
        ((eq item :d)
         (setf (elt *keys-down* 3) 1))
        ((eq item :q)
         (setf (elt *keys-down* 4) 1))
        ((eq item :e)
         (setf (elt *keys-down* 5) 1))
        ((eq item :shift)
         (setf (elt *keys-down* 6) 1))
        ((eq item :+)
         (setf (elt *keys-down* 7) 1))
        ((eq item :-)
         (setf (elt *keys-down* 8) 1))))

(def-mouse-button-callback mouse-watcher (window button action mod-keys)
  (declare (ignore window))
  (format t "~a ~a ~a ~%" button action mod-keys))

(def-cursor-pos-callback mouse-position-watcher (window x y)
  (declare (ignore window))
  (if *win-focused*
      (progn
        (let ((distance-x (- (first *win-middle*) x))
              (distance-y (- (second *win-middle*) y)))
          (setf *rotation-theta-y* (- *rotation-theta-y* (/ distance-x 10)))
          (setf *rotation-theta-x* (+ *rotation-theta-x* (/ distance-y -10))))
        (if (> *rotation-theta-x* 90)
            (setf *rotation-theta-x* 90))
        (if (< *rotation-theta-x* -90)
            (setf *rotation-theta-x* -90))
        (if (> (abs *rotation-theta-y*) 360)
            (setf *rotation-theta-y* 0))
        ;; The wrong data type will cause it to crash.
        (set-cursor-position (/ *win-width* 2.0d0) (/ *win-height* 2.0d0)))))

(def-key-callback keyboard-watcher (window key scancode action mod-keys)
  (declare (ignore window scancode mod-keys))
  (when (and (eq key :escape) (eq action :press))
    (set-window-should-close))
  (when (and (eq key :w) (eq action :press))
    (add-to-key-list :w))
  (when (and (eq key :a) (eq action :press))
    (add-to-key-list :a))
  (when (and (eq key :s) (eq action :press))
    (add-to-key-list :s))
  (when (and (eq key :d) (eq action :press))
    (add-to-key-list :d))
  (when (and (eq key :q) (eq action :press))
    (add-to-key-list :q))
  (when (and (eq key :e) (eq action :press))
    (add-to-key-list :e))
  (when (and (eq key :left-shift) (eq action :press))
    (add-to-key-list :shift))
  (when (and (eq key :kp-add) (eq action :press))
    (add-to-key-list :+))
  (when (and (eq key :kp-subtract) (eq action :press))
    (add-to-key-list :-))
  (when (and (eq key :w) (eq action :release))
    (drop-from-key-list :w))
  (when (and (eq key :a) (eq action :release))
    (drop-from-key-list :a))
  (when (and (eq key :s) (eq action :release))
    (drop-from-key-list :s))
  (when (and (eq key :d) (eq action :release))
    (drop-from-key-list :d))
  (when (and (eq key :q) (eq action :release))
    (drop-from-key-list :q))
  (when (and (eq key :e) (eq action :release))
    (drop-from-key-list :e))
  (when (and (eq key :left-shift) (eq action :release))
    (drop-from-key-list :shift))
  (when (and (eq key :kp-add) (eq action :release))
    (drop-from-key-list :+))
  (when (and (eq key :kp-subtract) (eq action :release))
    (drop-from-key-list :-)))

(defun make-rect (x-start y-start z-start x-end y-end z-end &optional (color (list 1 1 1 1 1)))
  (gl:color (first color) (second color) (third color) (fourth color))
  (gl:begin :quads)
  (gl:vertex x-start y-start z-start)
  (gl:vertex x-end y-start z-end)
  (gl:vertex x-end y-end z-end)
  (gl:vertex x-start y-end z-start)
  (gl:end))

(defun make-floor (x-start z-start x-end z-end &optional (color (list 1 1 1 1)))
  (gl:color (first color) (second color) (third color))
  (gl:color 0.05 0.45 0.3)
  (gl:begin :quads)
  (gl:vertex x-start -10 z-start)
  (gl:vertex x-end -10 z-start)
  (gl:vertex x-end -10 z-end)
  (gl:vertex x-start -10 z-end)
  (gl:end)
  (gl:color 0.5 0.8 0.8)
  (gl:begin :lines)
  (gl:vertex x-start -10 z-start)
  (gl:vertex x-end -10 z-start)

  (gl:vertex x-end -10 z-start)
  (gl:vertex x-end -10 z-end)

  (gl:vertex x-end -10 z-end)
  (gl:vertex x-start -10 z-end)

  (gl:vertex x-start -10 z-end)
  (gl:vertex x-start -10 z-start)
  (gl:end))

(defun draw-cube ()
  (setf *cube-rotation* (+ *cube-rotation* *cube-rotation-speed*))
  (gl:disable :cull-face)
  (gl:with-pushed-matrix
    (gl:rotate *cube-rotation* 0 1 0)
    (gl:rotate 45 1 0 1)
    ;; Ground
    ;; Floating Cube
    (make-rect  5  5 -5  5 -5  5 (list (random 0.6) 0.9 1.0 0.5))
    (make-rect -5  5  5 -5 -5 -5 (list 0.6 0.7 1.0 0.5))
    (make-rect  5 -5 -5 -5  5 -5 (list (random 0.6) 0.9 1.0 0.5))
    (make-rect -5 -5  5  5  5  5 (list 0.6 0.7 1.0 0.5))
    (gl:color 0.6 0.7 1.0 0.3)
    (gl:begin :quads)
    (gl:vertex -5 -5 -5)
    (gl:vertex  5 -5 -5)
    (gl:vertex  5 -5  5)
    (gl:vertex -5 -5  5)
    (gl:end)
    (gl:color (random 0.6) 0.9 1.0 0.3)
    (gl:begin :quads)
    (gl:vertex -5  5  5)
    (gl:vertex  5  5  5)
    (gl:vertex  5  5 -5)
    (gl:vertex -5  5 -5)
    (gl:end))
  (gl:enable :cull-face))

(defun render ()
  ;; Need to change this so it is based on the direction facing.
  (if (not (null *win-focused*))
      (progn
        (let* ((speed (if (eq (elt *keys-down* 6) 1)
                         0.5
                         2.0))
              (cos-calc (* (cos (* *rotation-theta-y* pi-over-180)) speed))
              (sin-calc (* (sin (* *rotation-theta-y* pi-over-180)) speed)))
          (if (eq (elt *keys-down* 0) 1)
              (progn
                (setf *translation-z* (+ *translation-z* cos-calc))
                (setf *translation-x* (- *translation-x* sin-calc))))
          (if (eq (elt *keys-down* 1) 1)
              (progn
                (setf *translation-x* (+ *translation-x* cos-calc))
                (setf *translation-z* (+ *translation-z* sin-calc))))
          (if (eq (elt *keys-down* 2) 1)
              (progn
                (setf *translation-z* (- *translation-z* cos-calc))
                (setf *translation-x* (+ *translation-x* sin-calc))))
          (if (eq (elt *keys-down* 3) 1)
              (progn
                (setf *translation-z* (- *translation-z* sin-calc))
                (setf *translation-x* (- *translation-x* cos-calc))))
          (if (> *translation-z* 225)
              (setf *translation-z* 225))
          (if (< *translation-z* -225)
              (setf *translation-z* -225))
          (if (> *translation-x* 225)
              (setf *translation-x* 225))
          (if (< *translation-x* -225)
              (setf *translation-x* -225))
          (if (eq (elt *keys-down* 7) 1)
              (setf *cube-rotation-speed* (+ *cube-rotation-speed* 0.5)))
          (if (eq (elt *keys-down* 8) 1)
              (setf *cube-rotation-speed* (- *cube-rotation-speed* 0.5))))))
        (gl:clear :color-buffer)
        (gl:load-identity)
        (gl:with-pushed-matrix
          (gl:rotate *rotation-theta-x* 1 0 0)
          (gl:rotate *rotation-theta-y* 0 1 0)
          (gl:rotate *rotation-theta-z* 0 0 1)
          (gl:translate *translation-x* *translation-y* *translation-z*)
          ;; Ground
          (make-floor 225  75 175 125 (list 0.1 0.5 0.3))
          (make-floor 225 125 175 175 (list 0.8 0.4 0.2))
          (make-floor 225 175 175 225 (list 0.75 1.0 0.2))
          (make-floor 175  75 125 125 (list 0.35 1.0 0.2))
          (make-floor 175 125 125 175 (list 0.7 0.8 0.2))
          (make-floor 175 175 125 225 (list 0.7 0.9 0.2))
          (make-floor 125  75  75 125 (list 0.7 1.0 0.2))
          (make-floor 125 125  75 175 (list 0.7 0.3 0.2))
          (make-floor 125 175  75 225 (list 0.7 1.0 0.2))

          (make-floor 225 -75 175 -25 (list 0.7 0.5 0.2))
          (make-floor 225 -25 175  25 (list 0.8 0.4 0.2))
          (make-floor 225  25 175  75 (list 0.75 1.0 0.2))
          (make-floor 175 -75 125 -25 (list 0.35 1.0 0.2))
          (make-floor 175 -25 125  25 (list 0.7 0.8 0.2))
          (make-floor 175  25 125  75 (list 0.7 0.9 0.2))
          (make-floor 125 -75  75 -25 (list 0.7 1.0 0.2))
          (make-floor 125 -25  75  25 (list 0.7 0.3 0.2))
          (make-floor 125  25  75  75 (list 0.7 1.0 0.2))

          (make-floor 225 -225 175 -175 (list 0.7 0.5 0.2))
          (make-floor 225 -175 175 -125 (list 0.8 0.4 0.2))
          (make-floor 225 -125 175  -75 (list 0.75 1.0 0.2))
          (make-floor 175 -225 125 -175 (list 0.35 1.0 0.2))
          (make-floor 175 -175 125 -125 (list 0.7 0.8 0.2))
          (make-floor 175 -125 125  -75 (list 0.7 0.9 0.2))
          (make-floor 125 -225  75 -175 (list 0.7 1.0 0.2))
          (make-floor 125 -175  75 -125 (list 0.7 0.3 0.2))
          (make-floor 125 -125  75  -75 (list 0.7 1.0 0.2))

          (make-floor  75  75  25 125 (list 0.7 0.5 0.2))
          (make-floor  75 125  25 175 (list 0.8 0.4 0.2))
          (make-floor  75 175  25 225 (list 0.75 1.0 0.2))
          (make-floor  25  75 -25 125 (list 0.35 1.0 0.2))
          (make-floor  25 125 -25 175 (list 0.7 0.8 0.2))
          (make-floor  25 175 -25 225 (list 0.7 0.9 0.2))
          (make-floor -25  75 -75 125 (list 0.7 1.0 0.2))
          (make-floor -25 125 -75 175 (list 0.7 0.3 0.2))
          (make-floor -25 175 -75 225 (list 0.7 1.0 0.2))

          (make-floor  75 -75  25 -25 (list 0.7 0.5 0.2))
          (make-floor  75 -25  25  25 (list 0.8 0.4 0.2))
          (make-floor  75  25  25  75 (list 0.75 1.0 0.2))
          (make-floor  25 -75 -25 -25 (list 0.35 1.0 0.2))
          (make-floor  25 -25 -25  25 (list 0.7 0.8 0.2))
          (make-floor  25  25 -25  75 (list 0.7 0.9 0.2))
          (make-floor -25 -75 -75 -25 (list 0.7 1.0 0.2))
          (make-floor -25 -25 -75  25 (list 0.7 0.3 0.2))
          (make-floor -25  25 -75  75 (list 0.7 1.0 0.2))

          (make-floor  75 -225  25 -175 (list 0.7 0.5 0.2))
          (make-floor  75 -175  25 -125 (list 0.8 0.4 0.2))
          (make-floor  75 -125  25  -75 (list 0.75 1.0 0.2))
          (make-floor  25 -225 -25 -175 (list 0.35 1.0 0.2))
          (make-floor  25 -175 -25 -125 (list 0.7 0.8 0.2))
          (make-floor  25 -125 -25  -75 (list 0.7 0.9 0.2))
          (make-floor -25 -225 -75 -175 (list 0.7 1.0 0.2))
          (make-floor -25 -175 -75 -125 (list 0.7 0.3 0.2))
          (make-floor -25 -125 -75  -75 (list 0.7 1.0 0.2))

          (make-floor  -75  75 -125 125 (list 0.7 0.5 0.2))
