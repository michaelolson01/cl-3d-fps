          (make-floor -175 125 -225 175 (list 0.7 0.3 0.2))
          (make-floor -175 175 -225 225 (list 0.7 1.0 0.2))

          (make-floor  -75 -75 -125 -25 (list 0.7 0.5 0.2))
          (make-floor  -75 -25 -125  25 (list 0.8 0.4 0.2))
          (make-floor  -75  25 -125  75 (list 0.75 1.0 0.2))
          (make-floor -125 -75 -175 -25 (list 0.35 1.0 0.2))
          (make-floor -125 -25 -175  25 (list 0.7 0.8 0.2))
          (make-floor -125  25 -175  75 (list 0.7 0.9 0.2))
          (make-floor -175 -75 -225 -25 (list 0.7 1.0 0.2))
          (make-floor -175 -25 -225  25 (list 0.7 0.3 0.2))
          (make-floor -175  25 -225  75 (list 0.7 1.0 0.2))

          (make-floor  -75 -225 -125 -175 (list 0.7 0.5 0.2))
          (make-floor  -75 -175 -125 -125 (list 0.8 0.4 0.2))
          (make-floor  -75 -125 -125  -75 (list 0.75 1.0 0.2))
          (make-floor -125 -225 -175 -175 (list 0.35 1.0 0.2))
          (make-floor -125 -175 -175 -125 (list 0.7 0.8 0.2))
          (make-floor -125 -125 -175  -75 (list 0.7 0.9 0.2))
          (make-floor -175 -225 -225 -175 (list 0.7 1.0 0.2))
          (make-floor -175 -175 -225 -125 (list 0.7 0.3 0.2))
          (make-floor -175 -125 -225  -75 (list 0.7 1.0 0.2))

          (draw-cube)))

(defun set-viewport (width height)
  (gl:viewport 0 0 width height)
  (gl:matrix-mode :projection)
  (gl:load-identity)
  (glu:perspective 100.0 (/ width height) 0.1 1000)
  (gl:matrix-mode :modelview)
  (gl:load-identity))

(def-window-size-callback update-viewport (window w h)
  (declare (ignore window))
  (format t "Resizing window to ~d ~d~%" w h)
  (setf *win-width* w)
  (setf *win-height* h)
  (setf *win-middle* (list (/ w 2.0d0) (/ h 2.0d0)))
  (set-viewport *win-width* *win-height*))

(def-window-focus-callback window-focus-watcher (window focusedp)
  (declare (ignore window))
  (setf *win-focused* focusedp))

(let ((running nil))
  (defun run-loop ()
    (setf running t)
    (with-body-in-main-thread ()
      (with-init-window (:title "Window test" :width 600 :height 400)
        (setf %gl:*gl-get-proc-address* #'get-proc-address)
        (set-key-callback 'keyboard-watcher)
        (set-mouse-button-callback 'mouse-watcher)
        (set-window-size-callback 'update-viewport)
        (set-cursor-position-callback 'mouse-position-watcher)
        (set-window-focus-callback 'window-focus-watcher)
        (clear-color 0 0 0 0)
        (set-viewport 600 400)
        (set-input-mode :CURSOR :DISABLED)
        (gl:enable :cull-face)
        (gl:enable :texture-2d)
        (gl:enable :blend)
        (gl:blend-func :src-alpha :one-minus-src-alpha)
        (loop :while (and running (not (window-should-close-p))) :do
          (render)
          (swap-buffers)
          (poll-events)))))
  (defun stop-loop () (setf running nil)))

(run-loop) ; <- if you run this (C-c C-c), you can use the repl.
(stop-loop)
